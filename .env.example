# Modelo das variáveis do app. Localmente, gere o .env.local com `npm run env:local`.
# Nada aqui é segredo: tudo vai para o bundle do front.
EXPO_PUBLIC_APP_ENV=local
EXPO_PUBLIC_API_URL=http://127.0.0.1:8080
EXPO_PUBLIC_COGNITO_REGION=us-east-1
EXPO_PUBLIC_COGNITO_CLIENT_ID=<client id do .env.cognito do infra-base>
# Só no ambiente local (cognito-local):
EXPO_PUBLIC_COGNITO_ENDPOINT=http://localhost:9229
